  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 38
  indentLevel: 0
  storyText: Your beloved steps forward, meeting your eyes one last time before their
    transformation begins. You watch as they shift into something magnificent and
    monstrous; massive, powerful, with eyes that still hold recognition but also
    hunger.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
