  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 12
  indentLevel: 0
  storyText: Such passion. I can see why your wolf chose you.
  description: 
  character: {fileID: 2054823944}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
