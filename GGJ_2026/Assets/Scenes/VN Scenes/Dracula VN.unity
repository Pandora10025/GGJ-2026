  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 43
  indentLevel: 0
  storyText: "The golden chalice gleams in the candlelight, waiting.\r"
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
