  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 38
  indentLevel: 0
  storyText: 'His eyes bore into yours with the weight of eternity.

'
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
