  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 32
  indentLevel: 0
  text: I would never ask them to choose between me and their nature. I accept all
    of who they are.
  description: 
  targetBlock: {fileID: 674344642}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
