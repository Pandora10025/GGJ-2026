  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 30
  indentLevel: 0
  storyText: Can you share them with the ocean, knowing there will be days, weeks,
    months when they must return to the depths? When the call of the tide is stronger
    than your voice?
  description: 
  character: {fileID: 89020826}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
