  m_Script: {fileID: 11500000, guid: 841589fc622bc494aa5405f416fa1301, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 13
  indentLevel: 0
  text: Oh yes, Your majesty! I have heard tales of your wisdom and hopes that you
    might take pity upon my soul and point me in the right direction!
  description: 
  targetBlock: {fileID: 654695385}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
  setMenuDialog: {fileID: 0}
