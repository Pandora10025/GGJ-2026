  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 14
  indentLevel: 0
  storyText: King Lycaon barks out a laugh that draws attention from across the room.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
