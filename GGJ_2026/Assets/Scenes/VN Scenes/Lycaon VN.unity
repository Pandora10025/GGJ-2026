  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 8
  indentLevel: 0
  storyText: He leans back against the wall, arms crossed, studying you with an intensity
    that makes you feel like prey being assessed. But there's a hint of amusement
    in his expression too.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
