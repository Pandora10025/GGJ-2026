  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 16
  indentLevel: 0
  storyText: From the breast pocket of his suit he pulls out what looks to be a large
    tooth.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
