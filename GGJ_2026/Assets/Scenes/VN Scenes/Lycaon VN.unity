  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 15
  indentLevel: 0
  storyText: Well, at least you've got manners. More than I can say for most who
    stumble into our world.
  description: 
  character: {fileID: 771934711}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
