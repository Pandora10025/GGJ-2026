  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 23
  indentLevel: 0
  storyText: Siren wine, blessed by Pisodeon himself. It will grant you entry to
    the Ocean's Ball in one weeks' time. There you will meet Lorelei, who will determine
    if you are worthy to stand before Calypso.
  description: 
  character: {fileID: 804037582}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
