  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 8
  indentLevel: 0
  storyText: 'And not just any mortal: the one who seeks an audience without beloved
    Sorceress and Head Diplomat Calypso. How very bold of you.'
  description: 
  character: {fileID: 804037582}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
