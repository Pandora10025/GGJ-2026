  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 44
  indentLevel: 0
  storyText: What will it be?
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
