  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 17
  indentLevel: 0
  storyText: "Dracula doesn't attend every little soiree, darling. He has standards.
    The true Carnevale has yet to start. These prelude parties are just for the rest
    of us to play\u2026"
  description: 
  character: {fileID: 1188657202}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
