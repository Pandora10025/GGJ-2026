  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 29
  indentLevel: 0
  storyText: Because I want to see if your love survives the truth of what our world
    really is.
  description: 
  character: {fileID: 1188657202}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
