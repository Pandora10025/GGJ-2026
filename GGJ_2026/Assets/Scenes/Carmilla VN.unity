  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 19
  indentLevel: 0
  storyText: But once Carnevale truly begins there are a few special occasions in
    which he regularly graces the rest of us with his presence; Grand affairs where
    the old emerge from their lairs, where the true power of society makes itself
    known.
  description: 
  character: {fileID: 1188657202}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
