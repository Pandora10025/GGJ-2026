  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 18
  indentLevel: 0
  storyText: 'She pauses, tilting her head as if listening to music only she can
    hear.

'
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
